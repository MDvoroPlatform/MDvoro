NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI is server-only. Never prefix these with NEXT_PUBLIC_.
# Choose one provider and its model for the active integration.
MDVORO_ENABLE_AI=false
MDVORO_AI_PROVIDER=manual
MDVORO_AI_MODEL=

# Preferred provider-specific secrets. The generic key is retained for backwards compatibility.
MDVORO_OPENAI_API_KEY=
MDVORO_ANTHROPIC_API_KEY=
MDVORO_GOOGLE_API_KEY=
MDVORO_AI_API_KEY=

# Trusted provisioning CLI only (never expose to Next.js client code).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=

# Canonical public origin used for metadata, robots, sitemap and mutation CSRF checks.
NEXT_PUBLIC_SITE_URL=https://mdvoro.com
MDVORO_APP_ORIGIN=https://mdvoro.com

# DMCA / copyright operational contact. Configure truthful values before launch.
DMCA_AGENT_NAME=
DMCA_AGENT_ORGANIZATION=
DMCA_AGENT_EMAIL=
DMCA_AGENT_PHONE=
DMCA_AGENT_ADDRESS=

# Required in production to protect signup from automated abuse (Cloudflare Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
